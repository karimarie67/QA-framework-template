{
  "name": "qa-framework-template",
  "version": "1.0.0",
  "description": "Playwright QA automation Framework template, instantiated per client Engagement",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test tests/",
    "test:smoke": "playwright test tests/smoke_tests.spec.js --project=staging --project=staging-mobile",
    "test:regression": "playwright test tests/error_handling_tests.spec.js tests/forms_tests.spec.js tests/accessibility_tests.spec.js --project=staging --project=staging-mobile",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "coverage": "node scripts/coverage-map.js",
    "dashboard": "node dashboards/scripts/generate-dashboard.js",
    "report": "playwright show-report",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:template-check": "node scripts/template-check.js",
    "board:setup": "node scripts/setup-project-board.js",
    "labels:setup": "node scripts/setup-labels.js",
    "test:links": "playwright test tests/check-links.spec.js --project=link-checker",
    "test:a11y": "playwright test tests/accessibility_tests.spec.js --project=staging --project=staging-mobile",
    "test:skeleton": "node scripts/test-skeleton.js"
  },
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "automation"
  ],
  "author": "karimarie67",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.40.0",
    "exceljs": "4.4.0"
  }
}

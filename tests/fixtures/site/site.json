{
  "pages": [
    {
      "path": "/",
      "title": "Home | Fixture"
    },
    {
      "path": "/about",
      "title": "About | Fixture"
    },
    {
      "path": "/contact",
      "title": "Contact | Fixture"
    }
  ],
  "nav": [
    {
      "name": "Home",
      "path": "/"
    },
    {
      "name": "About",
      "path": "/about"
    },
    {
      "name": "Contact",
      "path": "/contact"
    }
  ],
  "footer": {
    "links": [
      "Privacy",
      "Terms"
    ]
  },
  "notFoundPath": "/this-page-does-not-exist",
  "notFoundText": "Page not found",
  "malformedPaths": [
    "/%ZZ",
    "/..%2f..%2f",
    "/<script>"
  ],
  "forms": [
    {
      "path": "/contact",
      "selector": "form",
      "fields": [
        {
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "label": "Email",
          "type": "email",
          "required": true
        }
      ]
    }
  ],
  "a11y": {
    "exclude": []
  },
  "auth": {
    "loginPath": "/login",
    "usernameLabel": "Username",
    "passwordLabel": "Password",
    "submitName": "Log in",
    "successText": "You're logged in",
    "protectedPath": "/account",
    "protectedText": "Your account"
  },
  "api": {
    "endpoints": [
      {
        "path": "/api/health",
        "status": 200,
        "contentType": "application/json",
        "jsonKeys": [
          "status",
          "version"
        ]
      },
      {
        "path": "/api/items",
        "status": 200,
        "contentType": "application/json",
        "itemKeys": [
          "id",
          "name"
        ],
        "minItems": 1
      }
    ]
  },
  "perf": {
    "budgets": {
      "lcpMs": 500,
      "cls": 0.1,
      "ttfbMs": 500,
      "loadMs": 2000
    },
    "settleMs": 1000
  },
  "visual": {
    "pages": [
      "/",
      "/about"
    ],
    "maxDiffPixelRatio": 0.01
  }
}
